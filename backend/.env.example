# Firebase Admin: set FIREBASE_SERVICE_ACCOUNT to the JSON filename/path, OR leave unset
# to use Application Default Credentials (e.g. Cloud Run service account).
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
FIREBASE_PROJECT_ID=

MODEL_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Required at startup (imported by backend_app.ai.ai). Must be set on Cloud Run too.
MODEL_NAME=gpt-4o-mini

EXTRACTION_SPEED=fast
EXTRACTION_FAST_MAX_TOKENS=220
AI_REPLY_POLISH=selective
STRONG_GEMINI_CLASSIFIER_MODEL=gemini-2.5-pro
CONVERSATION_TTL_HOURS=24

# Local dev: API_PORT=5000. Cloud Run sets PORT automatically (8080).
API_PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
